ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-5-5

# ask = confirm risky actions in terminal | auto = run allowlisted actions | deny = read-only
AGENT_APPROVAL_MODE=ask
SHELL_ALLOWLIST=ls,cat,git status,git diff,git log,pytest,python

# Email (use an app password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional Telegram push for scheduled runs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
